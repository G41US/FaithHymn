<resources>
    <style name="Theme.FaithHymn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.FaithHymn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#5B47F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.FaithHymn</item>
    </style>
</resources>
